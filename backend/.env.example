# Database Configuration (Railway automatically sets DATABASE_URL when PostgreSQL is added)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/job_board_db

# Security & JWT
SECRET_KEY=change-this-to-a-secure-random-secret-key-for-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_MINUTES=1440

# Environment Mode ("production" or "development")
ENVIRONMENT=production

# Allowed CORS Origins (comma-separated list of extra origins, e.g. your Vercel URL)
# Note: https://*.vercel.app is automatically supported by regex
CORS_ORIGINS=https://your-frontend-app.vercel.app

# Cookie Settings (Set COOKIE_SECURE=true for cross-origin HTTPS between Vercel and Railway)
COOKIE_SECURE=true
COOKIE_SAMESITE=none

# SMTP & Email Delivery Settings
# (Example for Gmail: host=smtp.gmail.com, port=587, and generate an App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME="Job-Board Platform"
SMTP_TLS=True
FRONTEND_URL=http://localhost:5173
