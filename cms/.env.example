# Payload CMS Secret (minimum 32 characters)
PAYLOAD_SECRET=your_payload_secret_must_be_at_least_32_characters_long_placeholder

# Payload Postgres Database URL (CMS dedicated database, e.g. local cms_dev)
# IMPORTANT: This CMS stores ONLY staff accounts and never connects to the job board database.
CMS_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cms_dev

# Job Board Platform FastAPI Backend Base URL
JOB_BOARD_API_URL=https://job-board-platform-pi.vercel.app

# Job Board Backend Service Account (used by CMS proxy client to authenticate with FastAPI)
CMS_SERVICE_EMAIL=cms-service@jobboard.internal
CMS_SERVICE_PASSWORD=placeholder_for_cms_service_account_password

# Public URL for Payload CMS (used for CORS, CSRF, and redirect validations)
CMS_PUBLIC_URL=http://localhost:3000

# Safety switch: When "true", blocks all mutating requests (POST, PATCH, DELETE) at server level.
# Set to "false" deliberately when ready to modify real data.
CMS_READ_ONLY=true

# Staff bootstrap credentials (used by scripts/create-staff.ts to seed initial admin user)
# Password must be at least 14 characters.
STAFF_EMAIL=admin@jobboard.internal
STAFF_PASSWORD=placeholder_minimum_14_characters_staff_password
